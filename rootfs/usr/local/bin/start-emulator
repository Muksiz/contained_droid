#!/bin/bash
set -euo pipefail

AVD=droid
AVD_DIR="$ANDROID_AVD_HOME/$AVD.avd"
CONFIG="$AVD_DIR/config.ini"

set_ini() {
    if grep -q "^$1=" "$CONFIG"; then
        sed -i "s|^$1=.*|$1=$2|" "$CONFIG"
    else
        echo "$1=$2" >> "$CONFIG"
    fi
}

if [ ! -f "$CONFIG" ]; then
    echo "Creating AVD '$AVD' from $ANDROID_IMAGE"
    echo no | avdmanager create avd -n "$AVD" -k "$ANDROID_IMAGE" -d pixel_6
    set_ini PlayStore.enabled true
    set_ini hw.keyboard yes
    set_ini hw.audioInput no
    set_ini hw.audioOutput yes
    set_ini showDeviceFrame no
    set_ini disk.dataPartition.size "$EMULATOR_DATA_SIZE"
    # A small screen keeps software rendering cheap; audio is what matters here.
    set_ini hw.lcd.width 720
    set_ini hw.lcd.height 1280
    set_ini hw.lcd.density 320
fi

# Lock files survive an unclean stop and make the emulator refuse to start.
rm -rf "$AVD_DIR"/*.lock

# Play into the "emulator" sink, at Android's own mixing rate so that the
# emulator does not resample. droid-audio picks the stream up from there.
export QEMU_AUDIO_DRV=pa PULSE_SINK=emulator QEMU_AUDIO_DAC_FIXED_FREQ=48000
# The emulator asks PulseAudio for a ~10 ms buffer, which underruns. Nobody
# listens live, so trade latency for a cushion. Keep both buffers modest: until
# they have filled up the emulator pads its output with filler (removed again
# by droid-audio), and huge buffers take many minutes to fill.
export PULSE_LATENCY_MSEC="$EMULATOR_AUDIO_BUFFER_MS" QEMU_PA_SAMPLES=2048
# -feature -PlayStoreImage only removes the "Google Play" page from the
# emulator's settings window; the Play Store inside Android is unaffected.
# With the page present the emulator runs "adb shell dumpsys package ..."
# every 10 seconds, and forking a process of several GB freezes it for
# 100-200 ms each time - long enough for Android to throw audio away.
exec emulator -avd "$AVD" \
    -memory "$EMULATOR_RAM_MB" -cores "$EMULATOR_CORES" \
    -gpu swangle_indirect \
    -feature -PlayStoreImage \
    -no-snapshot -no-boot-anim -no-metrics
